// Uplinx — Material You 3 Expressive proxy client UI.
import "fonts/Rubik.ttf";
import "fonts/Unbounded.ttf";
import "fonts/MaterialIconsRound-Regular.otf";
import { ListView, ScrollView } from "std-widgets.slint";
import { Shapes } from "shapes.slint";
import { Theme, Ds, Appear, Logo, Icon, IconButton, Button, Chip, Segmented, Switch, Card, Title, Shape, Avatar, Field, Area, Progress, Dialog, Surface } from "theme.slint";
import { Ui, Logic, FieldItem, AppItem } from "data.slint";
import { Nav, ServersPage, SubsPage, RoutingPage, LogsPage, SettingsPage } from "pages.slint";
import { HomePage, ConnectButton } from "home.slint";

export { Theme, Ui, Logic, Nav }

component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (danger ? #c42b1c : Theme.on-surface.with-alpha(ta.pressed ? 0.12 : 0.08)) : transparent;
    animate background { duration: Ds.t-fast; }
    Icon { glyph: root.glyph; font-size: 16px; color: ta.has-hover && danger ? white : Theme.on-surface; }
    ta := TouchArea { clicked => { root.clicked(); } }
}


component TitleBar inherits Rectangle {
    in property <bool> maximized;
    height: 40px;
    background: Theme.surface-container;
    TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { Logic.drag(); } }
        double-clicked => { Logic.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: Ds.s4; spacing: Ds.s3; alignment: start;
        Text { text: "Uplinx"; font-family: "Unbounded"; font-weight: 600; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 24px;
            width: st.preferred-width + 34px;
            border-radius: self.height / 2;
            background: Ui.status == 2 ? Theme.primary-container : Theme.surface-container-highest;
            animate background { duration: Ds.t-med; }
            animate width { duration: Ds.t-med; easing: cubic-bezier(0.38, 1.21, 0.22, 1.00); }
            // the dot breathes while connecting
            property <float> beat: Theme.motion && Ui.status == 1 ? (1 + sin(animation-tick() / 900ms * 360deg)) / 2 : 1;
            Rectangle {
                x: 10px; width: 8px; height: 8px; border-radius: self.height / 2;
                opacity: 0.4 + 0.6 * parent.beat;
                background: Ui.status == 2 ? Theme.good : (Ui.status == 1 ? Theme.warn : (Ui.status == 3 ? Theme.error : Theme.on-surface-variant));
                animate background { duration: Ds.t-med; }
            }
            st := Text {
                x: 26px; vertical-alignment: center; font-size: 12px;
                text: Ui.status == 2 ? Ui.status-text + " · " + Ui.server-name : Ui.status-text;
                color: Ui.status == 2 ? Theme.on-primary-container : Theme.on-surface;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        WindowButton { glyph: "\u{e8e8}"; clicked => { Logic.toggle-mini(); } }
        WindowButton { glyph: "\u{e15b}"; clicked => { Logic.minimize(); } }
        WindowButton { glyph: root.maximized ? "\u{e3e0}" : "\u{e3c6}"; clicked => { Logic.toggle-maximize(); } }
        WindowButton { glyph: "\u{e5cd}"; danger: true; clicked => { Logic.close(); } }
    }
}

component RailItem inherits VerticalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    spacing: Ds.s1;
    alignment: center;
    Rectangle {
        height: 32px;
        // the M3 indicator grows out of the icon when selected; a hover shows a softer one
        Rectangle {
            width: root.selected ? 56px : (ta.has-hover ? 48px : 24px);
            height: parent.height;
            border-radius: self.height / 2;
            background: root.selected ? Theme.secondary-container : Theme.on-surface.with-alpha(ta.has-hover ? (ta.pressed ? 0.12 : 0.08) : 0);
            animate width { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
            animate background { duration: Ds.t-fast; }
        }
        Icon {
            glyph: root.glyph; color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant;
            transform-scale: ta.pressed ? 0.85 : 1;
            animate transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    }
    Text { text: root.label; font-size: 12px; font-weight: root.selected ? 700 : 500; color: root.selected ? Theme.on-surface : Theme.on-surface-variant; horizontal-alignment: center; overflow: elide; }
}

component Snackbar inherits Rectangle {
    property <float> t: 0;
    init => { root.t = 1; }
    animate t { duration: Theme.motion ? Ds.t-slow : 0ms; easing: cubic-bezier(0.38, 1.21, 0.22, 1.00); }
    opacity: min(1, root.t);
    transform-scale: 0.85 + 0.15 * root.t;
    height: 52px;
    width: min(lay.preferred-width, 640px);
    border-radius: Ds.r-s;
    background: Theme.inverse-surface;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000050;
    lay := HorizontalLayout {
        padding-left: Ds.s4; padding-right: Ds.s2; spacing: Ds.s2;
        Text { text: Ui.message; color: Theme.inverse-on-surface; font-size: 14px; vertical-alignment: center; overflow: elide; }
        if Ui.message-action != "": Rectangle {
            width: at.preferred-width + 2 * Ds.s3;
            at := Text { text: Ui.message-action; color: Theme.primary; font-weight: 700; font-size: 14px; }
            TouchArea { mouse-cursor: pointer; clicked => { Logic.message-action(); } }
        }
        IconButton { glyph: "\u{e5cd}"; tooltip: @tr("Close"); tint: Theme.inverse-on-surface; clicked => { Logic.dismiss("message"); } }
    }
}

/** First start: who made Uplinx, the licence and the terms. "I agree" unlocks after 10 seconds of reading. */
component Disclaimer inherits Rectangle {
    property <int> left: 10;
    background: #000000b8;
    TouchArea { } // nothing behind it can be clicked
    Timer { interval: 1s; running: root.left > 0; triggered => { root.left -= 1; } }
    Rectangle {
        width: min(640px, root.width - 2 * Ds.page);
        height: min(lay.preferred-height, root.height - 2 * Ds.page);
        border-radius: Ds.r-xl;
        background: Theme.surface-container-high;
        drop-shadow-blur: 24px; drop-shadow-color: #00000060;
        clip: true;
        lay := VerticalLayout {
            padding: Ds.s5; spacing: Ds.s4;
            HorizontalLayout {
                spacing: Ds.s3;
                Rectangle {
                    width: 48px; height: 48px; border-radius: Ds.r-m; background: Theme.primary-container;
                    Logo { size: 30px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; ink: Theme.on-primary-container; }
                }
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    Text { text: @tr("Before you start"); font-family: "Unbounded"; font-weight: 600; font-size: 20px; color: Theme.on-surface; }
                    Text { text: "Uplinx " + Ui.app-version; font-size: 12px; color: Theme.on-surface-variant; }
                }
                VerticalLayout { alignment: center; Segmented {
                    width: 220px;
                    options: ["English", "Русский"];
                    index: Ui.settings.language == 2 ? 1 : 0;
                    picked(i) => { Logic.set-int("language", i == 1 ? 2 : 1); }
                } }
            }
            ScrollView {
                vertical-stretch: 1;
                min-height: min(320px, root.height - 330px);
                VerticalLayout {
                    spacing: Ds.s3; padding-right: Ds.s3;
                    for p in [
                        { g: "\u{e7fd}", t: @tr("Uplinx is free, open-source software by alexkonstich-byte, released under the MIT License.") },
                        { g: "\u{e875}", t: @tr("Uplinx is only a client. It does not provide VPN servers, sell subscriptions or collect your data: servers come from the subscriptions and links you add yourself.") },
                        { g: "\u{e90d}", t: @tr("Use it in line with the laws of your country and the terms of your provider. You alone are responsible for how you use it.") },
                        { g: "\u{e002}", t: @tr("The software is provided “as is”, without warranty of any kind. The authors are not liable for any damage or loss arising from its use.") },
                        { g: "\u{e86f}", t: @tr("Xray-core (MPL-2.0), Twemoji flags (CC-BY 4.0) and other open-source parts are used under their own licences.") },
                    ]: HorizontalLayout {
                        spacing: Ds.s3;
                        Icon { glyph: p.g; font-size: 20px; width: 24px; color: Theme.primary; vertical-alignment: top; }
                        Text { text: p.t; font-size: 14px; color: Theme.on-surface; wrap: word-wrap; horizontal-stretch: 1; }
                    }
                }
            }
            Rectangle {
                height: 1px; background: Theme.outline-variant;
            }
            HorizontalLayout {
                spacing: Ds.s4;
                VerticalLayout { spacing: 2px; alignment: center;
                    Text { text: @tr("Author"); font-size: 11px; color: Theme.on-surface-variant; }
                    Text { text: "alexkonstich-byte"; font-size: 13px; color: Theme.on-surface; }
                }
                VerticalLayout { spacing: 2px; alignment: center;
                    Text { text: @tr("Licence"); font-size: 11px; color: Theme.on-surface-variant; }
                    Text { text: "MIT"; font-size: 13px; color: Theme.on-surface; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Button { kind: 2; glyph: "\u{e86f}"; text: "GitHub"; clicked => { Logic.open-url("https://github.com/alexkonstich-byte/uplinx"); } } }
            }
            HorizontalLayout {
                alignment: end; spacing: Ds.s2;
                Button { kind: 3; text: @tr("Quit"); clicked => { Logic.quit(); } }
                Button {
                    text: root.left > 0 ? @tr("I agree ({})", root.left) : @tr("I agree");
                    enabled: root.left == 0;
                    clicked => { Logic.accept-disclaimer(); }
                }
            }
        }
    }
}

component Actions inherits HorizontalLayout {
    alignment: end;
    spacing: Ds.s2;
}

export component AppWindow inherits Window {
    title: "Uplinx";
    icon: @image-url("../assets/uplinx-512.png");
    no-frame: true;
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 620px;
    background: Theme.surface;
    default-font-family: "Rubik";
    in property <bool> is-maximized;
    init => { keys.focus(); }

    // keyboard shortcuts: keys nobody else handled bubble up to here
    keys := FocusScope {
    key-pressed(e) => {
        if e.modifiers.control {
            if e.text == "v" || e.text == "V" { Logic.import-clipboard(); return accept; }
            if e.text == "f" || e.text == "F" { Nav.page = 1; Nav.focus-search += 1; return accept; }
            if e.text == "n" || e.text == "N" { Nav.dialog = "import"; return accept; }
            if e.text == "1" { Nav.page = 0; return accept; }
            if e.text == "2" { Nav.page = 1; return accept; }
            if e.text == "3" { Nav.page = 2; return accept; }
            if e.text == "4" { Nav.page = 3; return accept; }
            if e.text == "5" { Nav.page = 4; return accept; }
            if e.text == "6" { Nav.page = 5; return accept; }
        }
        if e.text == Key.Escape {
            if Nav.dialog != "" { Nav.dialog = ""; } else if Nav.edit-layout { Nav.edit-layout = false; } else { Logic.dismiss("all"); }
            return accept;
        }
        if e.text == Key.F5 { if Nav.page == 2 { Logic.update-all-subs(); } else { Logic.ping-all(); } return accept; }
        reject
    }

    VerticalLayout {
        TitleBar { maximized: root.is-maximized; }
        HorizontalLayout {
            Rectangle {
                width: 96px;
                background: Theme.surface-container;
                VerticalLayout {
                    padding-top: Ds.s3; padding-bottom: Ds.s4; spacing: Ds.s3;
                    // the logo in its container; clicking it opens Home
                    Rectangle {
                        height: 56px;
                        Rectangle {
                            width: 56px; height: 56px;
                            border-radius: logo-ta.pressed ? self.width / 2 : Ds.r-m;
                            background: Theme.primary-container;
                            transform-scale: logo-ta.pressed ? 0.92 : 1;
                            animate border-radius, transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
                            Logo { size: 34px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; ink: Theme.on-primary-container; }
                            logo-ta := TouchArea { mouse-cursor: pointer; clicked => { Nav.page = 0; } }
                        }
                    }
                    RailItem { glyph: "\u{e88a}"; label: @tr("Home"); selected: Nav.page == 0; clicked => { Nav.page = 0; } }
                    RailItem { glyph: "\u{e875}"; label: @tr("Servers"); selected: Nav.page == 1; clicked => { Nav.page = 1; } }
                    RailItem { glyph: "\u{eb5a}"; label: @tr("Subscriptions"); selected: Nav.page == 2; clicked => { Nav.page = 2; } }
                    RailItem { glyph: "\u{f184}"; label: @tr("Routing"); selected: Nav.page == 3; clicked => { Nav.page = 3; } }
                    RailItem { glyph: "\u{eb8e}"; label: @tr("Logs"); selected: Nav.page == 4; clicked => { Nav.page = 4; } }
                    Rectangle { vertical-stretch: 1; }
                    RailItem { glyph: "\u{e8b8}"; label: @tr("Settings"); selected: Nav.page == 5; clicked => { Nav.page = 5; } }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                // every screen slides in softly when you switch to it
                if Nav.page == 0: Appear { HomePage { } }
                if Nav.page == 1: Appear { ServersPage { } }
                if Nav.page == 2: Appear { SubsPage { } }
                if Nav.page == 3: Appear { RoutingPage { } }
                if Nav.page == 4: Appear { LogsPage { } }
                if Nav.page == 5: Appear { SettingsPage { } }
                if Ui.update-available && !Ui.update-ready && Nav.page != 5: Surface {
                    x: parent.width - self.width - Ds.page; y: parent.height - self.height - Ds.page;
                    width: ul.preferred-width; height: 56px; background: Theme.tertiary-container;
                    ul := HorizontalLayout {
                        padding-left: Ds.s4; padding-right: Ds.s2; spacing: Ds.s3;
                        Icon { glyph: "\u{e923}"; color: Theme.on-tertiary-container; width: 22px; }
                        Text { text: @tr("Version {} is available", Ui.update-version); color: Theme.on-tertiary-container; font-size: 14px; vertical-alignment: center; }
                        VerticalLayout { alignment: center; Button { kind: 0; text: @tr("Details"); clicked => { Nav.dialog = "update"; } } }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- clipboard offer + snackbar
    if Ui.clip-offer != "": Surface {
        width: cl.preferred-width; height: 56px;
        x: (root.width - self.width) / 2 + 48px;
        y: root.height - self.height - Ds.page - (Ui.message != "" ? 52px + Ds.s2 : 0);
        animate y { duration: Ds.t-med; easing: cubic-bezier(0.38, 1.21, 0.22, 1.00); }
        background: Theme.primary-container;
        cl := HorizontalLayout {
            padding-left: Ds.s4; padding-right: Ds.s2; spacing: Ds.s3;
            Icon { glyph: "\u{e14f}"; color: Theme.on-primary-container; width: 22px; }
            Text { text: @tr("In the clipboard: {}", Ui.clip-offer); color: Theme.on-primary-container; font-size: 14px; vertical-alignment: center; }
            VerticalLayout { alignment: center; Button { text: @tr("Add"); clicked => { Logic.clip-accept(); } } }
            VerticalLayout { alignment: center; IconButton { glyph: "\u{e5cd}"; tooltip: @tr("Not now"); tint: Theme.on-primary-container; clicked => { Logic.clip-dismiss(); } } }
        }
    }

    // ---------------------------------------------------------------- dialogs
    if Nav.dialog == "import": Dialog {
        title: @tr("Add servers"); glyph: "\u{e145}"; card-width: 620px;
        dismiss => { Nav.dialog = ""; }
        Text { text: @tr("Paste a link, a subscription URL, a WireGuard/AmneziaWG config, an Xray, sing-box or Clash config"); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
        paste := Area { height: 180px; placeholder: "vless://… · https://… · [Interface] … · vpn://…"; }
        HorizontalLayout {
            spacing: Ds.s2; alignment: start;
            Button { kind: 2; glyph: "\u{e14f}"; text: @tr("From clipboard"); clicked => { Nav.dialog = ""; Logic.import-clipboard(); } }
            Button { kind: 2; glyph: "\u{e2c7}"; text: @tr("File"); clicked => { Nav.dialog = ""; Logic.import-file(); } }
            Button { kind: 2; glyph: "\u{ef6b}"; text: @tr("QR on screen"); clicked => { Nav.dialog = ""; Logic.scan-screen(); } }
        }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Nav.dialog = ""; } }
            Button { text: @tr("Add"); enabled: paste.text != ""; clicked => { if Logic.import-text(paste.text) > 0 { Nav.dialog = ""; } } }
        }
    }

    if Nav.dialog == "add-sub": Dialog {
        title: @tr("Add subscription"); glyph: "\u{eb5a}";
        dismiss => { Nav.dialog = ""; }
        url := Field { label: @tr("Subscription URL"); placeholder: "https://"; accepted(t) => { if t != "" { Logic.add-sub(name.text, t); Nav.dialog = ""; } } }
        name := Field { label: @tr("Name (optional)"); }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Nav.dialog = ""; } }
            Button { text: @tr("Add"); enabled: url.text != ""; clicked => { Logic.add-sub(name.text, url.text); Nav.dialog = ""; } }
        }
    }

    if Nav.dialog == "edit-sub": Dialog {
        title: @tr("Edit subscription"); glyph: "\u{e3c9}";
        dismiss => { Nav.dialog = ""; }
        ename := Field { label: @tr("Name"); text: Nav.b; }
        eurl := Field { label: @tr("Subscription URL"); text: Nav.c; }
        ehours := Field { label: @tr("Auto-update, hours (0 — off)"); text: Nav.n; input-type: number; }
        eua := Field { label: @tr("User-Agent (empty — from settings)"); text: Nav.d; }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Nav.dialog = ""; } }
            Button { text: @tr("Save"); enabled: eurl.text != ""; clicked => { Logic.edit-sub(Nav.a, ename.text, eurl.text, ehours.text.to-float(), eua.text); Nav.dialog = ""; } }
        }
    }

    if Nav.dialog == "rule": Dialog {
        title: Nav.a == "" ? @tr("New rule") : @tr("Edit rule"); glyph: "\u{f184}";
        dismiss => { Nav.dialog = ""; }
        Segmented { options: [@tr("Domain"), "IP", "geosite", "geoip", @tr("Process"), @tr("Port")]; index: Nav.b == "IP" ? 1 : (Nav.b == "GEOSITE" ? 2 : (Nav.b == "GEOIP" ? 3 : (Nav.b == "PROCESS" ? 4 : (Nav.b == "PORT" ? 5 : 0)))); picked(i) => { Nav.b = ["DOMAIN", "IP", "GEOSITE", "GEOIP", "PROCESS", "PORT"][i]; } }
        rv := Field {
            label: @tr("Value");
            accepted(t) => { if t != "" { Logic.save-rule(Nav.a, Nav.b, t, Nav.d); Nav.dialog = ""; } }
            text: Nav.c;
            placeholder: Nav.b == "DOMAIN" ? "example.com" : (Nav.b == "IP" ? "1.2.3.0/24" : (Nav.b == "GEOSITE" ? "category-ads-all" : (Nav.b == "GEOIP" ? "ru" : (Nav.b == "PROCESS" ? "telegram.exe" : "443, 6881-6889"))));
        }
        Segmented { options: [@tr("Proxy"), @tr("Direct"), @tr("Block")]; index: Nav.d == "DIRECT" ? 1 : (Nav.d == "BLOCK" ? 2 : 0); picked(i) => { Nav.d = ["PROXY", "DIRECT", "BLOCK"][i]; } }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Nav.dialog = ""; } }
            Button { text: @tr("Save"); enabled: rv.text != ""; clicked => { Logic.save-rule(Nav.a, Nav.b, rv.text, Nav.d); Nav.dialog = ""; } }
        }
    }

    if Nav.dialog == "sites": Dialog {
        title: @tr("Sites to check"); glyph: "\u{e8be}";
        dismiss => { Nav.dialog = ""; }
        Text { text: @tr("One per line. They are checked through the tunnel after connecting."); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
        sites := Area { height: 200px; text: Nav.c; }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Nav.dialog = ""; } }
            Button { text: @tr("Save"); clicked => { Logic.set-sites(sites.text); Nav.dialog = ""; } }
        }
    }

    if Nav.dialog == "processes": Dialog {
        title: @tr("Running apps"); glyph: "\u{e5c3}"; card-width: 600px;
        dismiss => { Nav.dialog = ""; }
        Text { text: Nav.b == "split" ? @tr("Click a program to add it to split tunnelling.") : @tr("Choose where each program's traffic goes."); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
        ListView {
            height: 380px;
            for p in Ui.processes: Rectangle {
                height: 52px; border-radius: Ds.r-s;
                background: Theme.on-surface.with-alpha(pa.has-hover ? 0.06 : 0);
                animate background { duration: Ds.t-fast; }
                pa := TouchArea { mouse-cursor: Nav.b == "split" ? pointer : default; clicked => { if Nav.b == "split" { Logic.split-add(p.name); } } }
                HorizontalLayout {
                    padding-left: Ds.s3; padding-right: Ds.s3; spacing: Ds.s3;
                    if p.has-icon: Image { source: p.icon; width: 28px; height: 28px; y: (parent.height - self.height) / 2; }
                    if !p.has-icon: Icon { glyph: "\u{e5c3}"; font-size: 22px; width: 28px; color: Theme.on-surface-variant; }
                    Text { text: p.name; font-size: 14px; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    if Nav.b != "split": VerticalLayout { alignment: center; HorizontalLayout { spacing: Ds.s1;
                        Chip { text: "VPN"; clicked => { Logic.rule-from-app(p.name, "PROXY"); } }
                        Chip { text: @tr("Direct"); clicked => { Logic.rule-from-app(p.name, "DIRECT"); } }
                        Chip { text: @tr("Block"); clicked => { Logic.rule-from-app(p.name, "BLOCK"); } }
                    } }
                }
            }
        }
        Actions { Button { text: @tr("Done"); clicked => { Nav.dialog = ""; } } }
    }

    if Nav.dialog == "update": Dialog {
        title: @tr("Version {} is available", Ui.update-version); glyph: "\u{e923}"; card-width: 600px;
        dismiss => { Nav.dialog = ""; }
        ScrollView { height: 240px; VerticalLayout { padding-right: Ds.s3; Text { text: Ui.update-notes; font-size: 13px; color: Theme.on-surface; wrap: word-wrap; } } }
        if Ui.update-progress >= 0: Progress { value: Ui.update-progress; }
        Actions {
            Button { kind: 3; text: @tr("Later"); clicked => { Logic.dismiss-update(); Nav.dialog = ""; } }
            Button { kind: 1; text: @tr("In background"); enabled: Ui.update-progress < 0; clicked => { Logic.update-in-background(); Nav.dialog = ""; } }
            Button { text: @tr("Update now"); enabled: Ui.update-progress < 0; clicked => { Logic.install-update(); } }
        }
    }

    if Ui.whats-new: Dialog {
        title: @tr("What's new in {}", Ui.whats-new-version); glyph: "\u{e031}"; card-width: 600px;
        dismiss => { Logic.dismiss("whats-new"); }
        ScrollView { height: 260px; VerticalLayout { padding-right: Ds.s3; Text { text: Ui.whats-new-notes; font-size: 13px; color: Theme.on-surface; wrap: word-wrap; } } }
        Actions { Button { text: @tr("Great"); clicked => { Logic.dismiss("whats-new"); } } }
    }

    if Ui.show-error: Dialog {
        title: Ui.error-title; glyph: "\u{e000}"; card-width: 600px;
        dismiss => { Logic.dismiss("error"); }
        Text { text: Ui.error-hint; font-size: 14px; color: Theme.on-surface; wrap: word-wrap; }
        Rectangle {
            height: 160px; border-radius: Ds.r-s; background: Theme.surface-container-highest;
            ScrollView { Text { x: 12px; y: 10px; width: parent.width - 24px; text: Ui.error-details; font-family: "Consolas"; font-size: 12px; color: Theme.on-surface-variant; wrap: char-wrap; } }
        }
        Actions {
            Button { kind: 3; text: @tr("Copy"); clicked => { Logic.copy(Ui.error-details); } }
            Button { kind: 1; text: @tr("Logs"); clicked => { Logic.dismiss("error"); Nav.page = 4; } }
            Button { text: @tr("OK"); clicked => { Logic.dismiss("error"); } }
        }
    }

    if Ui.need-admin: Dialog {
        title: @tr("Administrator rights needed"); glyph: "\u{e32a}";
        dismiss => { Logic.dismiss("admin"); }
        Text { text: @tr("TUN mode and AmneziaWG change network routes, which Windows only allows to administrators. Restart Uplinx as administrator?"); font-size: 14px; color: Theme.on-surface-variant; wrap: word-wrap; }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Logic.dismiss("admin"); } }
            Button { text: @tr("Restart as administrator"); clicked => { Logic.relaunch-admin(); } }
        }
    }

    if Ui.need-amnezia: Dialog {
        title: @tr("AmneziaWG is needed"); glyph: "\u{e897}";
        dismiss => { Logic.dismiss("amnezia"); }
        Text { text: @tr("This config uses AmneziaWG obfuscation (S/H parameters) that only the official AmneziaWG client can run. Install it, then connect again."); font-size: 14px; color: Theme.on-surface-variant; wrap: word-wrap; }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Logic.dismiss("amnezia"); } }
            Button { text: @tr("Download AmneziaWG"); clicked => { Logic.install-amnezia(); } }
        }
    }

    if Ui.pending-import: Dialog {
        title: @tr("Import?"); glyph: "\u{e2c4}";
        dismiss => { Logic.confirm-import(false); }
        Text { text: Ui.pending-summary; font-size: 14px; color: Theme.on-surface; wrap: word-wrap; }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Logic.confirm-import(false); } }
            Button { text: @tr("Import"); clicked => { Logic.confirm-import(true); } }
        }
    }

    if Ui.show-qr: Dialog {
        title: Ui.qr-title; glyph: "\u{ef6b}"; card-width: 420px;
        dismiss => { Logic.dismiss("qr"); }
        HorizontalLayout { alignment: center; Rectangle { width: 300px; height: 300px; border-radius: Ds.r-m; background: white; clip: true; Image { source: Ui.qr-image; width: 280px; height: 280px; image-rendering: pixelated; } } }
        Actions { Button { text: @tr("Close"); clicked => { Logic.dismiss("qr"); } } }
    }

    if Ui.show-editor: Dialog {
        title: Ui.editor-title; glyph: "\u{e3c9}"; card-width: 640px;
        dismiss => { Logic.dismiss("editor"); }
        property <[FieldItem]> fields: Ui.editor-fields;
        ScrollView {
            height: min(440px, root.height - 260px);
            VerticalLayout {
                spacing: Ds.s2; padding-right: Ds.s3;
                for f[i] in fields: Field { label: f.label; text: f.value; edited(t) => { fields[i].value = t; } }
            }
        }
        Actions {
            Button { kind: 3; text: @tr("Cancel"); clicked => { Logic.dismiss("editor"); } }
            Button { text: @tr("Save"); clicked => { Logic.editor-save(fields); } }
        }
    }

    // ---------------------------------------------------------------- drag & drop
    if Ui.drop-hover: Appear {
        lift: 0; length: Ds.t-med;
        background: Theme.surface.with-alpha(0.85);
        Rectangle {
            x: Ds.page; y: Ds.page; width: parent.width - 2 * Ds.page; height: parent.height - 2 * Ds.page;
            border-radius: Ds.r-xl; border-width: 2px; border-color: Theme.primary;
            background: Theme.primary.with-alpha(0.06);
            VerticalLayout {
                alignment: center; spacing: Ds.s3;
                Icon { glyph: "\u{e2c6}"; font-size: 56px; color: Theme.primary; }
                Text { text: @tr("Drop to import"); font-family: "Unbounded"; font-weight: 600; font-size: 22px; color: Theme.on-surface; horizontal-alignment: center; }
                Text { text: @tr("Configs, subscriptions and QR code pictures"); font-size: 14px; color: Theme.on-surface-variant; horizontal-alignment: center; }
            }
        }
    }
    // messages stay visible above dialogs (an import that failed inside a dialog must say why)
    if Ui.message != "": Snackbar {
        x: (root.width - self.width) / 2 + 48px;
        y: root.height - self.height - Ds.page;
    }
    // the first-start notice sits above everything, including dialogs
    if Ui.show-disclaimer: Disclaimer { }
    } // keys
}

/** Compact always-on-top window: connect button, server and speed. */
export component MiniWindow inherits Window {
    title: "Uplinx";
    icon: @image-url("../assets/uplinx-512.png");
    no-frame: true;
    always-on-top: true;
    width: 300px;
    height: 132px;
    background: Theme.surface-container;
    default-font-family: "Rubik";
    TouchArea { pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { Logic.drag(); } } }
    HorizontalLayout {
        padding: Ds.s3; spacing: Ds.s3;
        VerticalLayout { alignment: center; ConnectButton { size: 76px; } }
        VerticalLayout {
            alignment: center; spacing: Ds.s1; horizontal-stretch: 1;
            Text { text: Ui.status-text; font-family: "Unbounded"; font-weight: 600; font-size: 15px; color: Theme.on-surface; overflow: elide; }
            Text { text: Ui.server-name; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
            Text { text: "↓ " + Ui.down-speed + "   ↑ " + Ui.up-speed; font-size: 12px; color: Theme.on-surface-variant; }
        }
        VerticalLayout {
            alignment: start;
            IconButton { width: 32px; height: 32px; glyph: "\u{e5d0}"; tooltip: @tr("Open the main window"); clicked => { Logic.toggle-mini(); } }
        }
    }
}
