// Home: a dashboard of widgets on a 12-column grid. In edit mode widgets can be dragged, resized, added and removed.
import { Theme, Ds, Logo, Field, Icon, IconButton, Button, Chip, Segmented, Card, Label, Shape, Avatar, Progress, Spark, Surface, MenuItem, Appear } from "theme.slint";
import { Ui, Logic, WidgetItem, NodeItem } from "data.slint";
import { Shapes } from "shapes.slint";
import { Nav, PingChip } from "pages.slint";

/** The hero button: a cookie that turns while the window is active, faster when connecting. */
export component ConnectButton inherits Rectangle {
    in property <length> size: 200px;
    property <int> state: Ui.status;
    property <float> speed: state == 1 ? 1.0 / 1.6 : (state == 2 ? 1.0 / 16 : 1.0 / 40);
    property <angle> spin: Theme.motion ? mod(animation-tick() / 1s * speed, 1.0) * 360deg : 0deg;
    width: size * 1.3; height: size * 1.3;
    // 0 -> 1 once when the connection comes up: a ring runs out and the shape pops
    property <float> pulse: state == 2 ? 1 : 0;
    animate pulse { duration: state == 2 && Theme.motion ? 900ms : 0ms; easing: cubic-bezier(0.20, 0.00, 0.00, 1.00); }
    Rectangle {
        width: root.size * 1.22; height: self.width; border-radius: self.width / 2;
        background: Theme.primary.with-alpha(root.state == 2 ? 0.12 : 0);
        animate background { duration: Ds.t-slow; }
    }
    Rectangle {
        width: root.size * (1 + 0.3 * root.pulse); height: self.width; border-radius: self.width / 2;
        border-width: 3px; border-color: Theme.primary.with-alpha(0.6 * (1 - root.pulse) * (root.state == 2 ? 1 : 0));
    }
    Rectangle {
        width: root.size; height: root.size;
        transform-rotation: root.spin;
        transform-scale: (ta.pressed ? 0.9 : (ta.has-hover ? 1.04 : 1.0)) + 0.08 * sin(root.pulse * 180deg);
        animate transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
        Shape {
            width: 100%; height: 100%;
            shape: root.state == 2 ? Shapes.cookie9 : (root.state == 1 ? Shapes.soft-burst : Shapes.cookie12);
            fill: root.state == 2 ? Theme.primary : (root.state == 1 ? Theme.tertiary-container : (root.state == 3 ? Theme.error-container : Theme.surface-container-highest));
            animate fill { duration: Ds.t-slow; }
        }
    }
    Icon {
        glyph: "\u{e8ac}";
        font-size: root.size * 0.3;
        color: root.state == 2 ? Theme.on-primary : (root.state == 1 ? Theme.on-tertiary-container : (root.state == 3 ? Theme.on-error-container : Theme.on-surface-variant));
        animate color { duration: Ds.t-slow; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { Logic.toggle-connect(); } }
}

component Head inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> title;
    spacing: Ds.s2;
    height: 32px;
    Icon { glyph: root.glyph; font-size: 18px; color: Theme.primary; width: 20px; }
    Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    @children
}

component Big inherits Text {
    font-family: "Unbounded";
    font-weight: 600;
    color: Theme.on-surface;
    overflow: elide;
}

component ConnectW inherits Rectangle {
    // the button (with its halo, x1.3) plus two lines of text must fit inside the card padding
    property <length> s: min((self.width - 2 * Ds.s5) / 1.3, (self.height - 2 * Ds.s5 - 72px) / 1.3);
    VerticalLayout {
        padding: Ds.s5; spacing: Ds.s1; alignment: center;
        HorizontalLayout { alignment: center; ConnectButton { size: max(64px, root.s); } }
        Big { text: Ui.status-text; font-size: root.width > 380px ? 26px : 20px; horizontal-alignment: center; }
        Text { text: Ui.server-name; font-size: 14px; color: Theme.on-surface-variant; horizontal-alignment: center; overflow: elide; }
        if Ui.preparing: VerticalLayout {
            spacing: Ds.s2; padding-top: Ds.s2;
            Text { text: Ui.prep-text; font-size: 12px; color: Theme.on-surface-variant; horizontal-alignment: center; }
            HorizontalLayout { alignment: center; Progress { width: 180px; value: Ui.prep-progress; } }
        }
    }
}

component ServerW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e875}"; title: @tr("Server"); }
        HorizontalLayout {
            spacing: Ds.s4; vertical-stretch: 1;
            VerticalLayout { alignment: center; Avatar { flag: Ui.server-flag; has-flag: Ui.server-has-flag; selected: Ui.status == 2; } }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                Text { text: Ui.server-name; font-size: 16px; font-weight: 600; color: Theme.on-surface; overflow: elide; }
                Text { text: Ui.server-detail; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
            }
            VerticalLayout { alignment: center; IconButton { glyph: "\u{e5cc}"; tooltip: @tr("All servers"); clicked => { Nav.page = 1; } } }
        }
    }
}

component ModesW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2; alignment: center;
        Segmented { options: [@tr("System proxy"), "TUN"]; index: Ui.settings.connect-mode; picked(i) => { Logic.set-connect-mode(i); } }
        Segmented { options: [@tr("By rules"), @tr("Global"), @tr("Direct")]; index: Ui.routing.mode; picked(i) => { Logic.set-routing-mode(i); } }
    }
}

component SpeedW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e9e4}"; title: @tr("Speed"); }
        HorizontalLayout {
            spacing: Ds.s4;
            HorizontalLayout { spacing: Ds.s1; Icon { glyph: "\u{f090}"; font-size: 18px; color: Theme.primary; width: 18px; } Big { text: Ui.down-speed; font-size: 20px; } }
            HorizontalLayout { spacing: Ds.s1; Icon { glyph: "\u{f09b}"; font-size: 18px; color: Theme.tertiary; width: 18px; } Big { text: Ui.up-speed; font-size: 20px; } }
        }
        if Ui.status != 2: Text { vertical-stretch: 1; text: @tr("Connect to see the live speed"); font-size: 13px; color: Theme.on-surface-variant; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        if Ui.status == 2: Rectangle {
            vertical-stretch: 1;
            Spark { width: 100%; height: 100%; values: Ui.speed-down-values; }
            Spark { width: 100%; height: 50%; y: parent.height / 2; values: Ui.speed-up-values; tint: Theme.tertiary; alpha: 0.8; }
        }
    }
}

component PingW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e1d8}"; title: @tr("Ping"); IconButton { width: Ds.mini-icon; height: Ds.mini-icon; glyph: "\u{e5d5}"; tooltip: @tr("Measure now"); clicked => { Logic.ping-current(); } } }
        Big { text: Ui.ping-now; font-size: 22px; }
        if Ui.ping-stats != "": Text { text: Ui.ping-stats; font-size: 11px; color: Theme.on-surface-variant; overflow: elide; }
        if Ui.ping-values.length >= 2: Spark { vertical-stretch: 1; values: Ui.ping-values; tint: Theme.secondary; }
        if Ui.ping-values.length < 2: Text { vertical-stretch: 1; text: Ui.status == 2 ? @tr("Measuring…") : @tr("The chart appears after connecting"); font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; wrap: word-wrap; }
    }
}

component IpW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e80b}"; title: @tr("Your IP"); IconButton { width: Ds.mini-icon; height: Ds.mini-icon; glyph: "\u{e5d5}"; tooltip: @tr("Refresh"); enabled: !Ui.ip-loading; clicked => { Logic.refresh-ip(); } } }
        Big { text: Ui.ip-loading ? "…" : (Ui.ip == "" ? "—" : Ui.ip); font-size: 18px; }
        HorizontalLayout {
            spacing: Ds.s2;
            if Ui.ip-has-flag: Image { source: Ui.ip-flag; width: 18px; height: 18px; }
            Text { text: Ui.ip-place; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; vertical-alignment: center; }
        }
        Text { text: Ui.ip-isp; font-size: 11px; color: Theme.on-surface-variant; overflow: elide; }
    }
}

component QuotaW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e1db}"; title: Ui.has-quota ? Ui.quota-title : @tr("Subscription"); }
        if !Ui.has-quota: Text { text: @tr("No subscription data"); font-size: 13px; color: Theme.on-surface-variant; }
        if Ui.has-quota: Big { text: Ui.quota-text; font-size: 17px; }
        if Ui.has-quota && Ui.quota-used >= 0: Progress { value: Ui.quota-used; }
        if Ui.has-quota: Text { text: Ui.quota-expire; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
    }
}

component ServersW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e8ee}"; title: @tr("Servers"); IconButton { width: Ds.mini-icon; height: Ds.mini-icon; glyph: "\u{e9e4}"; tooltip: @tr("Test all"); enabled: !Ui.pinging; clicked => { Logic.ping-all(); } } }
        Flickable {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                spacing: Ds.list-gap / 2;
                for n in Ui.top-nodes: Rectangle {
                    height: 48px; border-radius: n.selected || ta.pressed ? Ds.r-m : Ds.r-s;
                    background: n.selected ? Theme.secondary-container : (ta.pressed ? Theme.surface-container-highest : (ta.has-hover ? Theme.surface-container-high : transparent));
                    animate background { duration: Ds.t-fast; }
                    animate border-radius { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
                    ta := TouchArea { mouse-cursor: pointer; clicked => { Logic.select-node(n.id); } }
                    HorizontalLayout {
                        padding-left: Ds.s2; padding-right: Ds.s2; spacing: Ds.s3;
                        VerticalLayout { alignment: center; Avatar { size: 32px; flag: n.flag; has-flag: n.has-flag; selected: n.selected; glyph: n.glyph; } }
                        Text { text: n.name; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; PingChip { ping: n.ping; testing: n.testing; clicked => { Logic.ping-node(n.id); } } }
                    }
                }
            }
        }
    }
}

component SessionW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e8b5}"; title: @tr("Session"); }
        Big { text: Ui.session-time; font-size: 22px; }
        HorizontalLayout {
            spacing: Ds.s4;
            Text { text: "↓ " + Ui.down-total; font-size: 13px; color: Theme.on-surface-variant; }
            Text { text: "↑ " + Ui.up-total; font-size: 13px; color: Theme.on-surface-variant; }
        }
    }
}

component SitesW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head {
            glyph: "\u{e8be}"; title: @tr("Sites");
            IconButton { width: Ds.mini-icon; height: Ds.mini-icon; glyph: "\u{e3c9}"; tooltip: @tr("Edit the list"); clicked => { Nav.c = Ui.sites-text; Nav.dialog = "sites"; } }
            IconButton { width: Ds.mini-icon; height: Ds.mini-icon; glyph: "\u{e5d5}"; tooltip: @tr("Check now"); enabled: !Ui.sites-checking; clicked => { Logic.check-sites(); } }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: sl.preferred-height;
            sl := VerticalLayout {
                for s in Ui.sites: HorizontalLayout {
                    height: 28px; spacing: Ds.s2;
                    VerticalLayout { alignment: center; Rectangle {
                        width: 10px; height: 10px; border-radius: self.width / 2;
                        background: !s.checked ? Theme.outline-variant : (s.ms < 0 || s.code >= 400 ? Theme.error : Theme.good);
                        animate background { duration: Ds.t-med; }
                    } }
                    Text { text: s.site; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    Text { text: !s.checked ? "" : (s.ms < 0 ? @tr("unavailable") : s.ms + " ms"); font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; }
                }
            }
        }
    }
}

component SpeedTestW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e9e4}"; title: @tr("Speed test"); }
        HorizontalLayout {
            spacing: Ds.s4;
            VerticalLayout { Text { text: @tr("Download"); font-size: 11px; color: Theme.on-surface-variant; } Big { text: Ui.speed-down; font-size: 18px; } }
            VerticalLayout { Text { text: @tr("Upload"); font-size: 11px; color: Theme.on-surface-variant; } Big { text: Ui.speed-up; font-size: 18px; } }
            VerticalLayout { Text { text: @tr("Ping"); font-size: 11px; color: Theme.on-surface-variant; } Big { text: Ui.speed-ping; font-size: 18px; } }
        }
        if Ui.speed-running: VerticalLayout {
            spacing: Ds.s2;
            Text { text: Ui.speed-now; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
            Progress { value: Ui.speed-phase >= 2 ? Ui.speed-fraction : -1; }
        }
        if !Ui.speed-running: Text { text: Ui.speed-node; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
        Rectangle { vertical-stretch: 1; }
        Button { kind: 1; glyph: "\u{e037}"; text: Ui.speed-running ? @tr("Testing…") : @tr("Start"); enabled: !Ui.speed-running; clicked => { Logic.run-speed-test(); } }
    }
}

/** Speedometer: the running test, the live download, or the last result. Click to run a speed test. */
component GaugeW inherits Rectangle {
    TouchArea { mouse-cursor: Ui.speed-running ? default : pointer; clicked => { if !Ui.speed-running && !Nav.edit-layout { Logic.run-speed-test(); } } }
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s1;
        Head { glyph: "\u{e9e4}"; title: @tr("Speedometer"); }
        Rectangle {
            vertical-stretch: 1;
            property <length> d: min(self.width, self.height);
            dial := Rectangle {
                width: parent.d; height: parent.d;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                Path { width: 100%; height: 100%; viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 100; commands: Ui.gauge-track; fill: Theme.surface-container-highest; }
                if Ui.gauge-fill != "": Path { width: 100%; height: 100%; viewbox-x: 0; viewbox-y: 0; viewbox-width: 100; viewbox-height: 100; commands: Ui.gauge-fill;
                    fill: @linear-gradient(90deg, Theme.tertiary 0%, Theme.primary 100%); }
                VerticalLayout {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    alignment: center; spacing: 0;
                    Text { text: Ui.gauge-value; font-family: "Unbounded"; font-weight: 600; font-size: max(16px, dial.height * 0.17); color: Theme.on-surface; horizontal-alignment: center; }
                    Text { text: "Mbps"; font-size: max(10px, dial.height * 0.06); color: Theme.on-surface-variant; horizontal-alignment: center; }
                }
                Text { x: parent.width * 0.2; y: parent.height * 0.84; text: "0"; font-size: 11px; color: Theme.on-surface-variant; }
                Text { x: parent.width * 0.8 - self.width; y: parent.height * 0.84; text: Ui.gauge-max; font-size: 11px; color: Theme.on-surface-variant; }
            }
        }
        Text { text: Ui.speed-running ? Ui.speed-now : Ui.gauge-caption; font-size: 12px; color: Theme.on-surface-variant; horizontal-alignment: center; overflow: elide; }
    }
}

component UsageW inherits Rectangle {
    VerticalLayout {
        padding: Ds.card; spacing: Ds.s2;
        Head { glyph: "\u{e26b}"; title: @tr("Usage"); Text { text: Ui.usage-total; font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; } }
        bars := Rectangle {
            vertical-stretch: 1;
            property <length> bw: self.width / max(1, Ui.usage.length);
            for b[i] in Ui.usage: Rectangle {
                x: i * bars.bw + 2px; width: bars.bw - 4px;
                height: max(3px, (bars.height - 16px) * b.value);
                y: bars.height - 16px - self.height;
                border-radius: min(Ds.s1, self.width / 2);
                background: Theme.primary.with-alpha(0.35 + 0.65 * b.value);
                animate height, y { duration: Ds.t-med; easing: cubic-bezier(0.20, 0.00, 0.00, 1.00); }
                Text { y: parent.height + 2px; text: b.label; font-size: 9px; color: Theme.on-surface-variant; }
            }
        }
        Text { text: Ui.all-time; font-size: 11px; color: Theme.on-surface-variant; overflow: elide; }
    }
}

/**
 * One dashboard widget. In edit mode it can be dragged (body) and resized (corner): it follows the pointer exactly,
 * a tinted cell shows where it will land, and on release it springs into that cell while the others make room.
 */
component Tile inherits Rectangle {
    in property <WidgetItem> w;
    in property <length> cell;     // column width
    in property <length> row-h;    // row height
    in property <length> gap;
    property <length> step-x: cell + gap;
    property <length> step-y: row-h + gap;
    property <length> dx;
    property <length> dy;
    property <length> dw;
    property <length> dh;
    property <bool> moving;
    property <bool> sizing;
    property <bool> busy: moving || sizing;
    x: w.x * step-x + dx;
    y: w.y * step-y + dy;
    width: max(w.min-w * cell + (w.min-w - 1) * gap, w.w * cell + (w.w - 1) * gap + dw);
    height: max(w.min-h * row-h + (w.min-h - 1) * gap, w.h * row-h + (w.h - 1) * gap + dh);
    // while dragging the tile sticks to the pointer; after release (or when another tile pushes it) it springs
    animate x, y, width, height { duration: busy || !Theme.motion ? 0ms : Ds.t-slow; easing: cubic-bezier(0.38, 1.21, 0.22, 1.00); }
    z: busy ? 10 : 0;
    // where it will land
    property <int> snap-w: clamp(round((self.width + gap) / step-x), w.min-w, 12 - w.x);
    property <int> snap-h: max(w.min-h, round((self.height + gap) / step-y));
    property <int> snap-col: clamp(round(self.x / step-x), 0, 12 - w.w);
    property <int> snap-row: max(0, round(self.y / step-y));

    property <float> shown: 0;
    init => { root.shown = 1; }
    animate shown { duration: Theme.motion ? Ds.t-slow + (root.w.y * 2 + root.w.x) * 12ms : 0ms; easing: cubic-bezier(0.05, 0.70, 0.10, 1.00); }
    opacity: root.shown;
    transform-scale: (0.94 + 0.06 * root.shown) * (busy ? 1.02 : (Nav.edit-layout ? 0.98 : 1));
    animate transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }

    // drop target, drawn under the card and kept still while the tile moves
    if root.busy: Rectangle {
        x: (root.moving ? root.snap-col * root.step-x : root.w.x * root.step-x) - root.x;
        y: (root.moving ? root.snap-row * root.step-y : root.w.y * root.step-y) - root.y;
        width: (root.moving ? root.w.w : root.snap-w) * root.step-x - root.gap;
        height: (root.moving ? root.w.h : root.snap-h) * root.step-y - root.gap;
        border-radius: Ds.r-l;
        background: Theme.primary.with-alpha(0.12);
        border-width: 2px; border-color: Theme.primary.with-alpha(0.6);
    }
    card := Rectangle {
        border-radius: Ds.r-l;
        background: Theme.surface-container;
        border-width: Nav.edit-layout ? 2px : 0;
        border-color: root.busy ? Theme.primary : Theme.outline-variant;
        animate border-color { duration: Ds.t-fast; }
        drop-shadow-blur: root.busy ? 24px : 0;
        drop-shadow-color: #00000050;
        clip: true;
        if root.w.kind == "CONNECT": ConnectW { }
        if root.w.kind == "SERVER": ServerW { }
        if root.w.kind == "MODES": ModesW { }
        if root.w.kind == "SPEED": SpeedW { }
        if root.w.kind == "PING": PingW { }
        if root.w.kind == "IP": IpW { }
        if root.w.kind == "QUOTA": QuotaW { }
        if root.w.kind == "SERVERS": ServersW { }
        if root.w.kind == "SESSION": SessionW { }
        if root.w.kind == "SITES": SitesW { }
        if root.w.kind == "SPEEDTEST": SpeedTestW { }
        if root.w.kind == "USAGE": UsageW { }
        if root.w.kind == "SPEEDOMETER": GaugeW { }
    }
    if Nav.edit-layout: Appear {
        lift: 0; length: Ds.t-med;
        border-radius: Ds.r-l;
        background: Theme.surface.with-alpha(root.busy ? 0.15 : 0.35);
        TouchArea {
            mouse-cursor: move;
            // the area moves with the tile, so each move adds only what is left of the way to the pointer
            moved => { if root.moving { root.dx += self.mouse-x - self.pressed-x; root.dy += self.mouse-y - self.pressed-y; } }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.moving = true; }
                if e.kind == PointerEventKind.up && root.moving {
                    root.moving = false;
                    Logic.widget-move(root.w.id, root.snap-col, root.snap-row);
                    root.dx = 0; root.dy = 0;
                }
            }
        }
        Rectangle {
            x: Ds.s3; y: Ds.s3; width: Ds.mini-icon; height: Ds.mini-icon; border-radius: self.width / 2;
            background: rm.has-hover ? Theme.error : Theme.error-container;
            animate background { duration: Ds.t-fast; }
            transform-scale: rm.pressed ? 0.85 : 1;
            animate transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
            Icon { glyph: "\u{e5cd}"; font-size: 18px; color: rm.has-hover ? Theme.surface : Theme.on-error-container; }
            rm := TouchArea { mouse-cursor: pointer; clicked => { Logic.widget-remove(root.w.id); } }
        }
        Rectangle {
            x: parent.width - self.width - Ds.s3; y: parent.height - self.height - Ds.s3; width: Ds.mini-icon; height: Ds.mini-icon;
            border-radius: self.width / 2; background: Theme.primary;
            transform-scale: rs.pressed ? 1.15 : (rs.has-hover ? 1.08 : 1);
            animate transform-scale { duration: Ds.t-med; easing: cubic-bezier(0.42, 1.67, 0.21, 0.90); }
            Icon { glyph: "\u{e5d0}"; font-size: 16px; color: Theme.on-primary; transform-rotation: 45deg; }
            rs := TouchArea {
                mouse-cursor: nwse-resize;
                moved => { if root.sizing { root.dw += self.mouse-x - self.pressed-x; root.dh += self.mouse-y - self.pressed-y; } }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.sizing = true; }
                    if e.kind == PointerEventKind.up && root.sizing {
                        root.sizing = false;
                        Logic.widget-resize(root.w.id, root.snap-w, root.snap-h);
                        root.dw = 0; root.dh = 0;
                    }
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    property <length> gap: Ds.card-gap;
    property <length> pad: Ds.page;
    property <length> cell: (self.width - 2 * pad - 11 * gap) / 12;
    property <length> row-h: 64px;
    property <int> added; // bumped when a widget is added: the grid scrolls to it
    property <[{k: string, t: string, g: string}]> kinds: [
        { k: "CONNECT", t: @tr("Connect"), g: "\u{e8ac}" }, { k: "SERVER", t: @tr("Server"), g: "\u{e875}" },
        { k: "MODES", t: @tr("Modes"), g: "\u{f184}" }, { k: "SPEED", t: @tr("Speed"), g: "\u{e9e4}" },
        { k: "PING", t: @tr("Ping"), g: "\u{e1d8}" }, { k: "IP", t: @tr("Your IP"), g: "\u{e80b}" },
        { k: "QUOTA", t: @tr("Subscription"), g: "\u{e1db}" }, { k: "SERVERS", t: @tr("Servers"), g: "\u{e8ee}" },
        { k: "SESSION", t: @tr("Session"), g: "\u{e8b5}" }, { k: "SITES", t: @tr("Sites"), g: "\u{e8be}" },
        { k: "SPEEDTEST", t: @tr("Speed test"), g: "\u{e9e4}" }, { k: "USAGE", t: @tr("Usage"), g: "\u{e26b}" },
        { k: "SPEEDOMETER", t: @tr("Speedometer"), g: "\u{e9e4}" },
    ];
    // decorative shapes; they only move while connecting
    property <angle> drift: Theme.motion && Ui.status == 1 ? mod(animation-tick() / 30s, 1.0) * 360deg : 0deg;
    Shape { x: root.width - 260px; y: -80px; width: 360px; height: 360px; shape: Shapes.soft-burst; fill: Theme.primary.with-alpha(0.05); transform-rotation: root.drift; }
    Shape { x: -120px; y: root.height - 240px; width: 320px; height: 320px; shape: Shapes.clover4; fill: Theme.tertiary.with-alpha(0.05); transform-rotation: -root.drift; }

    if !Ui.has-servers: VerticalLayout {
        alignment: center; padding: Ds.page;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: min(600px, root.width - 2 * Ds.page);
                height: ob.preferred-height;
                border-radius: Ds.r-xl;
                background: Theme.surface-container;
                ob := VerticalLayout {
                    padding: Ds.s5 * 1.5; spacing: Ds.s4;
                    HorizontalLayout { alignment: center; Rectangle {
                        width: 80px; height: 80px; border-radius: Ds.r-l; background: Theme.primary-container;
                        Logo { size: 48px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; ink: Theme.on-primary-container; }
                    } }
                    Text { text: @tr("Welcome to Uplinx"); font-family: "Unbounded"; font-weight: 600; font-size: 24px; color: Theme.on-surface; horizontal-alignment: center; }
                    Text { text: @tr("Paste the subscription link from your VPN provider — or any server link, config or QR code."); font-size: 14px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: Ds.s2;
                        first := Field { label: @tr("Subscription or link"); placeholder: "https://…  ·  vless://…"; horizontal-stretch: 1; accepted(t) => { if Logic.import-text(t) > 0 { self.text = ""; } } }
                        VerticalLayout { alignment: center; Button { glyph: "\u{e145}"; text: @tr("Add"); enabled: first.text != ""; clicked => { if Logic.import-text(first.text) > 0 { first.text = ""; } } } }
                    }
                    HorizontalLayout {
                        alignment: center; spacing: Ds.s2;
                        Button { kind: 2; glyph: "\u{e14f}"; text: @tr("From clipboard"); clicked => { Logic.import-clipboard(); } }
                        Button { kind: 2; glyph: "\u{ef6b}"; text: @tr("QR on screen"); clicked => { Logic.scan-screen(); } }
                        Button { kind: 2; glyph: "\u{e2c7}"; text: @tr("File"); clicked => { Logic.import-file(); } }
                    }
                    Text { text: @tr("Tip: you can also drop files onto this window or press Ctrl+V."); font-size: 12px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
                }
            }
        }
    }
    if Ui.has-servers: VerticalLayout {
        HorizontalLayout {
            padding-left: root.pad; padding-right: root.pad; padding-top: Ds.page; padding-bottom: Ds.s4; spacing: Ds.s2; height: 80px;
            Text { text: Nav.edit-layout ? @tr("Drag widgets, pull the corner to resize") : ""; font-size: 13px; color: Theme.on-surface-variant; vertical-alignment: center; horizontal-stretch: 1; }
            if !Nav.edit-layout: Button { kind: 1; glyph: "\u{e145}"; text: @tr("Add servers"); clicked => { Nav.dialog = "import"; } }
            if Nav.edit-layout: Button { kind: 3; text: @tr("Reset"); clicked => { Logic.widgets-reset(); } }
            if Nav.edit-layout: Button { kind: 1; glyph: "\u{e145}"; text: @tr("Widget"); clicked => { add-menu.show(); } }
            Button { kind: Nav.edit-layout ? 0 : 2; glyph: Nav.edit-layout ? "\u{e5ca}" : "\u{e3c9}"; text: Nav.edit-layout ? @tr("Done") : @tr("Edit"); clicked => { Nav.edit-layout = !Nav.edit-layout; } }
        }
        flick := Flickable {
            vertical-stretch: 1;
            interactive: !Nav.edit-layout; // dragging a tile must move the tile, not the page
            property <int> watch: root.added;
            changed watch => { self.viewport-y = min(0px, self.height - self.content-height); }
            content-height: grid.height + Ds.page;
            grid := Rectangle {
                x: root.pad; y: 0;
                width: root.width - 2 * root.pad;
                height: Ui.grid-rows * (root.row-h + root.gap) + (Nav.edit-layout ? 3 * (root.row-h + root.gap) : 0);
                for w in Ui.widgets: Tile { w: w; cell: root.cell; row-h: root.row-h; gap: root.gap; }
            }
        }
    }
    add-menu := PopupWindow {
        x: root.width - 260px; y: 72px; width: 220px;
        Surface {
            VerticalLayout {
                padding: Ds.s1;
                for k in root.kinds: MenuItem {
                    glyph: k.g; text: k.t; glyph-color: Theme.primary;
                    clicked => {
                        add-menu.close();
                        Logic.widget-add(k.k);
                        // show the new widget: it lands at the bottom
                        root.added += 1;
                    }
                }
            }
        }
    }
}
