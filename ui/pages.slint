import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Icon, IconButton, Button, Chip, Segmented, Switch, Card, Title, Label, Row, Shape, Avatar, Field, Progress, Spark } from "theme.slint";
import { Ui, Logic, NodeItem, SubItem, RuleItem } from "data.slint";
import { Shapes } from "shapes.slint";

/** Navigation + dialog state shared by all screens. */
export global Nav {
    in-out property <int> page;
    in-out property <string> dialog;     // "" | import | add-sub | edit-sub | rule | sites | about
    in-out property <string> a;          // dialog arguments
    in-out property <string> b;
    in-out property <string> c;
    in-out property <string> d;
    in-out property <int> n;
    in-out property <bool> edit-layout;
    in-out property <bool> mini;
}

export component PingChip inherits Rectangle {
    in property <int> ping;
    in property <bool> testing;
    callback clicked;
    property <color> c: ping == -100 ? Theme.on-surface-variant : (ping < 0 ? Theme.error : (ping < 200 ? Theme.good : (ping < 500 ? Theme.warn : Theme.error)));
    height: 28px;
    width: max(64px, t.preferred-width + 20px);
    border-radius: 14px;
    background: ta.has-hover ? c.with-alpha(0.22) : c.with-alpha(0.12);
    t := Text {
        text: root.testing ? "···" : (root.ping == -100 ? "— ms" : (root.ping == -1 ? @tr("timeout") : (root.ping == -3 ? "TUN?" : root.ping + " ms")));
        font-size: 12px; font-weight: 600; color: root.c;
        opacity: root.testing ? 0.6 : 1;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component NodeRow inherits Rectangle {
    in property <NodeItem> n;
    height: n.header ? 44px : 68px;
    if root.n.header: HorizontalLayout {
        padding-left: 8px; padding-top: 12px; spacing: 8px; alignment: start;
        Text { text: root.n.name; font-size: 13px; font-weight: 700; color: Theme.primary; vertical-alignment: center; overflow: elide; }
        Text { text: root.n.count; font-size: 12px; color: Theme.on-surface-variant; vertical-alignment: center; }
    }
    if !root.n.header: Rectangle {
        y: 2px; height: parent.height - 4px;
        border-radius: root.n.selected ? 20px : 16px;
        background: root.n.selected ? Theme.secondary-container : (ta.has-hover ? Theme.surface-container-high : Theme.surface-container);
        opacity: root.n.hidden ? 0.55 : 1;
        animate background, border-radius { duration: 180ms; }
        ta := TouchArea { mouse-cursor: pointer; clicked => { Logic.select-node(root.n.id); } }
        HorizontalLayout {
            padding-left: 12px; padding-right: 8px; spacing: 14px;
            VerticalLayout { alignment: center; Avatar { flag: root.n.flag; has-flag: root.n.has-flag; selected: root.n.selected; glyph: root.n.glyph; } }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                Text { text: root.n.name; font-size: 15px; font-weight: root.n.selected ? 600 : 400; color: root.n.selected ? Theme.on-secondary-container : Theme.on-surface; overflow: elide; }
                Text { text: root.n.detail; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
            }
            VerticalLayout { alignment: center; PingChip { ping: root.n.ping; testing: root.n.testing; clicked => { Logic.ping-node(root.n.id); } } }
            VerticalLayout { alignment: center; IconButton { glyph: "\u{e5d4}"; clicked => { menu.show(); } } }
        }
        menu := PopupWindow {
            x: parent.width - 220px; y: parent.height - 8px; width: 210px;
            Rectangle {
                border-radius: 12px; background: Theme.surface-container-highest; drop-shadow-blur: 12px; drop-shadow-color: #00000050;
                VerticalLayout {
                    padding-top: 6px; padding-bottom: 6px;
                    for it in [
                        { k: "copy", t: @tr("Copy link"), g: "\u{e157}" },
                        { k: "qr", t: @tr("QR code"), g: "\u{ef6b}" },
                        { k: "speed", t: @tr("Speed test"), g: "\u{e9e4}" },
                        { k: "edit", t: @tr("Edit"), g: "\u{e3c9}" },
                        { k: root.n.hidden ? "unhide" : "hide", t: root.n.hidden ? @tr("Show") : @tr("Hide"), g: root.n.hidden ? "\u{e8f4}" : "\u{e8f5}" },
                        { k: "delete", t: @tr("Delete"), g: "\u{e872}" },
                    ]: Rectangle {
                        height: 40px;
                        background: mta.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent;
                        HorizontalLayout {
                            padding-left: 14px; spacing: 12px;
                            Icon { glyph: it.g; font-size: 18px; color: Theme.on-surface-variant; width: 20px; }
                            Text { text: it.t; font-size: 14px; color: it.k == "delete" ? Theme.error : Theme.on-surface; vertical-alignment: center; }
                        }
                        mta := TouchArea { clicked => { Logic.node-menu(root.n.id, it.k); } }
                    }
                }
            }
        }
    }
}

export component ServersPage inherits Rectangle {
    VerticalLayout {
        padding: 24px; padding-bottom: 8px; spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Title { text: @tr("Servers"); }
            Text { text: Ui.node-count; font-size: 14px; color: Theme.on-surface-variant; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 260px; height: 40px; border-radius: 20px; background: Theme.surface-container-high;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Icon { glyph: "\u{e8b6}"; font-size: 18px; color: Theme.on-surface-variant; width: 20px; }
                    search := TextInput {
                        vertical-alignment: center; font-size: 14px; color: Theme.on-surface; single-line: true;
                        edited => { Logic.search(self.text); }
                    }
                }
                if search.text == "": Text { x: 44px; text: @tr("Search"); font-size: 14px; color: Theme.on-surface-variant.with-alpha(0.7); }
            }
            Button { kind: 1; glyph: "\u{e9e4}"; text: Ui.pinging ? @tr("Testing…") : @tr("Test all"); enabled: !Ui.pinging; clicked => { Logic.ping-all(); } }
            Button { glyph: "\u{e145}"; text: @tr("Add"); clicked => { Nav.dialog = "import"; } }
        }
        HorizontalLayout {
            spacing: 8px; alignment: start;
            Chip { text: @tr("Manual"); selected: Ui.settings.server-sort == 0; clicked => { Logic.set-sort(0); } }
            Chip { text: @tr("Name"); selected: Ui.settings.server-sort == 1; clicked => { Logic.set-sort(1); } }
            Chip { text: @tr("Ping"); selected: Ui.settings.server-sort == 2; clicked => { Logic.set-sort(2); } }
            Chip { text: @tr("Recent"); selected: Ui.settings.server-sort == 3; clicked => { Logic.set-sort(3); } }
            Rectangle { width: 12px; }
            Chip { text: @tr("Hidden"); glyph: "\u{e8f4}"; selected: Ui.settings.show-hidden; clicked => { Logic.set-bool("show-hidden", !Ui.settings.show-hidden); } }
        }
        if Ui.nodes.length == 0: VerticalLayout {
            alignment: center; spacing: 12px; vertical-stretch: 1;
            HorizontalLayout { alignment: center; Shape { width: 96px; height: 96px; shape: Shapes.flower; fill: Theme.secondary-container; } }
            Text { text: @tr("No servers yet"); font-size: 18px; color: Theme.on-surface; horizontal-alignment: center; }
            Text { text: @tr("Paste a link, a subscription, a config or a QR code"); font-size: 13px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout { alignment: center; spacing: 8px;
                Button { glyph: "\u{e14f}"; text: @tr("From clipboard"); clicked => { Logic.import-clipboard(); } }
                Button { kind: 1; glyph: "\u{e145}"; text: @tr("Add"); clicked => { Nav.dialog = "import"; } }
            }
        }
        if Ui.nodes.length > 0: ListView {
            vertical-stretch: 1;
            for n in Ui.nodes: NodeRow { n: n; }
        }
    }
}

// ============================================================ subscriptions

component SubCard inherits Card {
    in property <SubItem> s;
    min-height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 18px; spacing: 10px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 48px; height: 48px;
                if !root.s.has-logo: Shape { width: 100%; height: 100%; shape: Shapes.clover4; fill: Theme.primary-container; }
                if !root.s.has-logo: Icon { glyph: "\u{eb5a}"; color: Theme.on-primary-container; }
                if root.s.has-logo: Rectangle { border-radius: 14px; clip: true; background: Theme.surface-container-highest; Image { source: root.s.logo; width: 100%; height: 100%; image-fit: contain; } }
            }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    if root.s.pinned: Icon { glyph: "\u{f10d}"; font-size: 16px; color: Theme.primary; width: 18px; }
                    Text { text: root.s.name; font-size: 17px; font-weight: 600; color: Theme.on-surface; overflow: elide; horizontal-stretch: 1; }
                }
                Text { text: root.s.info; font-size: 12px; color: Theme.on-surface-variant; overflow: elide; }
            }
            if root.s.updating: VerticalLayout { alignment: center; Progress { width: 48px; } }
            IconButton { glyph: "\u{e5d5}"; enabled: !root.s.updating; clicked => { Logic.update-sub(root.s.id); } }
            IconButton { glyph: root.s.pinned ? "\u{f10d}" : "\u{f10e}"; clicked => { Logic.pin-sub(root.s.id); } }
            IconButton { glyph: "\u{e3c9}"; clicked => { Nav.a = root.s.id; Nav.b = root.s.name; Nav.c = root.s.url; Nav.n = root.s.auto-hours; Nav.d = root.s.user-agent; Nav.dialog = "edit-sub"; } }
            IconButton { glyph: "\u{e872}"; clicked => { Logic.delete-sub(root.s.id); } }
        }
        if root.s.quota != "" || root.s.expire != "": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                Text { text: root.s.quota; font-size: 13px; color: root.s.used-up ? Theme.error : Theme.on-surface; horizontal-stretch: 1; }
                Text { text: root.s.expire; font-size: 13px; color: root.s.expired ? Theme.error : Theme.on-surface-variant; }
            }
            if root.s.used >= 0: Progress { value: root.s.used; }
        }
        if root.s.history.length > 2: Spark { height: 36px; values: root.s.history; }
        if root.s.expired || root.s.used-up: HorizontalLayout {
            spacing: 8px; alignment: start;
            if root.s.expired: Rectangle { height: 26px; width: et.preferred-width + 20px; border-radius: 8px; background: Theme.error-container; et := Text { text: @tr("Subscription expired"); font-size: 12px; color: Theme.on-error-container; } }
            if root.s.used-up: Rectangle { height: 26px; width: ut.preferred-width + 20px; border-radius: 8px; background: Theme.error-container; ut := Text { text: @tr("Out of traffic"); font-size: 12px; color: Theme.on-error-container; } }
        }
        if root.s.announce != "": Rectangle {
            border-radius: 14px; background: Theme.tertiary-container; min-height: at.preferred-height + 20px;
            at := Text { x: 14px; width: parent.width - 28px; text: root.s.announce; wrap: word-wrap; font-size: 13px; color: Theme.on-tertiary-container; }
        }
        if root.s.error != "": Text { text: root.s.error; font-size: 12px; color: Theme.error; wrap: word-wrap; }
        if root.s.support != "" || root.s.website != "": HorizontalLayout {
            spacing: 8px; alignment: start;
            if root.s.support != "": Button { kind: 2; glyph: "\u{e0c6}"; text: @tr("Support"); clicked => { Logic.open-url(root.s.support); } }
            if root.s.website != "": Button { kind: 2; glyph: "\u{e80b}"; text: @tr("Website"); clicked => { Logic.open-url(root.s.website); } }
        }
    }
}

export component SubsPage inherits Rectangle {
    VerticalLayout {
        padding: 24px; padding-bottom: 8px; spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            Title { text: @tr("Subscriptions"); }
            Rectangle { horizontal-stretch: 1; }
            Button { kind: 1; glyph: "\u{e5d5}"; text: @tr("Update all"); clicked => { Logic.update-all-subs(); } }
            Button { glyph: "\u{e145}"; text: @tr("Add subscription"); clicked => { Nav.b = ""; Nav.c = ""; Nav.dialog = "add-sub"; } }
        }
        if Ui.subs.length == 0: VerticalLayout {
            alignment: center; spacing: 12px; vertical-stretch: 1;
            HorizontalLayout { alignment: center; Shape { width: 96px; height: 96px; shape: Shapes.clover8; fill: Theme.secondary-container; } }
            Text { text: @tr("No subscriptions"); font-size: 18px; color: Theme.on-surface; horizontal-alignment: center; }
            Text { text: @tr("A subscription is a link from your VPN provider. Servers and remaining traffic update automatically."); font-size: 13px; color: Theme.on-surface-variant; horizontal-alignment: center; wrap: word-wrap; }
        }
        if Ui.subs.length > 0: ListView {
            vertical-stretch: 1;
            for s in Ui.subs: VerticalLayout { padding-bottom: 12px; SubCard { s: s; } }
        }
    }
}

// ============================================================ routing

component RuleRow inherits Rectangle {
    in property <RuleItem> r;
    in property <int> index;
    in property <int> total;
    height: 56px;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-container-high : Theme.surface-container;
    opacity: r.enabled ? 1 : 0.5;
    ta := TouchArea { mouse-cursor: pointer; clicked => { Nav.a = root.r.id; Nav.b = root.r.kind; Nav.c = root.r.value; Nav.d = root.r.action; Nav.dialog = "rule"; } }
    HorizontalLayout {
        padding-left: 14px; padding-right: 8px; spacing: 12px;
        Rectangle {
            width: 82px; height: 26px; y: (parent.height - self.height) / 2; border-radius: 13px;
            background: root.r.action == "BLOCK" ? Theme.error-container : (root.r.action == "DIRECT" ? Theme.tertiary-container : Theme.primary-container);
            Text {
                text: root.r.action == "BLOCK" ? @tr("Block") : (root.r.action == "DIRECT" ? @tr("Direct") : @tr("Proxy"));
                font-size: 12px; font-weight: 600;
                color: root.r.action == "BLOCK" ? Theme.on-error-container : (root.r.action == "DIRECT" ? Theme.on-tertiary-container : Theme.on-primary-container);
            }
        }
        Text { text: root.r.kind; font-size: 11px; color: Theme.on-surface-variant; vertical-alignment: center; width: 70px; }
        Text { text: root.r.value; font-size: 14px; color: Theme.on-surface; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        IconButton { glyph: "\u{e5ce}"; enabled: root.index > 0; clicked => { Logic.move-rule(root.r.id, -1); } }
        IconButton { glyph: "\u{e5cf}"; enabled: root.index < root.total - 1; clicked => { Logic.move-rule(root.r.id, 1); } }
        VerticalLayout { alignment: center; Switch { checked: root.r.enabled; toggled(v) => { Logic.toggle-rule(root.r.id, v); } } }
        IconButton { glyph: "\u{e872}"; clicked => { Logic.delete-rule(root.r.id); } }
    }
}

export component RoutingPage inherits Rectangle {
    ScrollView {
        VerticalLayout {
            padding: 24px; spacing: 16px;
            Title { text: @tr("Routing"); }
            Segmented {
                options: [@tr("By rules"), @tr("Global"), @tr("Direct")];
                index: Ui.routing.mode;
                picked(i) => { Logic.set-routing-mode(i); }
            }
            Text { text: Ui.routing.mode == 0 ? @tr("Presets and your rules decide what goes through the proxy.") : (Ui.routing.mode == 1 ? @tr("All traffic goes through the proxy.") : @tr("The core runs, but traffic bypasses it.")); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
            Card {
                min-height: presets.preferred-height;
                presets := VerticalLayout {
                    padding-top: 8px; padding-bottom: 8px;
                    Row { title: @tr("Local network directly"); subtitle: @tr("Router, printers and LAN addresses skip the proxy"); Switch { checked: Ui.routing.bypass-lan; toggled(v) => { Logic.set-routing-bool("bypass-lan", v); } } }
                    Row { title: @tr("Russian sites directly"); subtitle: @tr(".ru domains and Russian IPs skip the proxy"); Switch { checked: Ui.routing.bypass-ru; toggled(v) => { Logic.set-routing-bool("bypass-ru", v); } } }
                    Row { title: @tr("Block ads"); subtitle: @tr("Ad and tracker domains are dropped"); Switch { checked: Ui.routing.block-ads; toggled(v) => { Logic.set-routing-bool("block-ads", v); } } }
                    Row { title: @tr("Only blocked sites via proxy"); subtitle: @tr("Uses the runetfreedom list; everything else goes directly"); Switch { checked: Ui.routing.proxy-blocked-ru; toggled(v) => { Logic.set-routing-bool("proxy-blocked-ru", v); } } }
                    Row {
                        title: @tr("Domain strategy");
                        Segmented { width: 330px; options: ["AsIs", "IPIfNonMatch", "IPOnDemand"]; index: Ui.routing.domain-strategy; picked(i) => { Logic.set-domain-strategy(i); } }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text { text: @tr("Rules"); font-size: 18px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                Button { kind: 2; text: @tr("RU preset"); clicked => { Logic.apply-preset("ru"); } }
                Button { glyph: "\u{e145}"; text: @tr("Add rule"); clicked => { Nav.a = ""; Nav.b = "DOMAIN"; Nav.c = ""; Nav.d = "PROXY"; Nav.dialog = "rule"; } }
            }
            if Ui.rules.length == 0: Text { text: @tr("No rules yet. Presets above already cover the common cases."); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
            for r[i] in Ui.rules: RuleRow { r: r; index: i; total: Ui.rules.length; }

            // split tunnelling
            HorizontalLayout {
                padding-top: 12px; spacing: 12px;
                Text { text: @tr("Split tunnelling"); font-size: 18px; font-weight: 600; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                Switch { checked: Ui.routing.split-enabled; toggled(v) => { Logic.set-routing-bool("split-enabled", v); } }
            }
            Text { text: @tr("Choose which programs use the VPN. Works in both modes."); font-size: 13px; color: Theme.on-surface-variant; wrap: word-wrap; }
            if Ui.routing.split-enabled: VerticalLayout {
                spacing: 12px;
                Segmented { options: [@tr("Listed apps go directly"), @tr("Only listed apps use the VPN")]; index: Ui.routing.split-mode; picked(i) => { Logic.set-int("split-mode", i); } }
                HorizontalLayout {
                    spacing: 8px;
                    app-field := Field { label: @tr("Program"); placeholder: "telegram.exe"; horizontal-stretch: 1; accepted(t) => { Logic.split-add(t); self.text = ""; } }
                    VerticalLayout { alignment: center; Button { glyph: "\u{e145}"; text: @tr("Add"); clicked => { Logic.split-add(app-field.text); app-field.text = ""; } } }
                    VerticalLayout { alignment: center; Button { kind: 2; glyph: "\u{e8b6}"; text: @tr("Running apps"); clicked => { Logic.refresh-processes(); Nav.dialog = "processes"; } } }
                }
                for app in Ui.split-apps: Rectangle {
                    height: 48px; border-radius: 12px; background: Theme.surface-container;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 6px;
                        Icon { glyph: "\u{e5c3}"; font-size: 18px; width: 28px; color: Theme.on-surface-variant; }
                        Text { text: app; font-size: 14px; color: Theme.on-surface; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { glyph: "\u{e5cd}"; clicked => { Logic.split-remove(app); } }
                    }
                }
            }
        }
    }
}

// ============================================================ logs

export component LogsPage inherits Rectangle {
    in-out property <int> filter: 0;
    VerticalLayout {
        padding: 24px; padding-bottom: 8px; spacing: 14px;
        HorizontalLayout {
            spacing: 8px;
            Title { text: @tr("Logs"); }
            Rectangle { horizontal-stretch: 1; }
            Chip { text: @tr("All"); selected: root.filter == 0; clicked => { root.filter = 0; Logic.set-log-filter(0); } }
            Chip { text: @tr("Warnings"); selected: root.filter == 1; clicked => { root.filter = 1; Logic.set-log-filter(1); } }
            Chip { text: @tr("Errors"); selected: root.filter == 2; clicked => { root.filter = 2; Logic.set-log-filter(2); } }
            Rectangle { width: 8px; }
            Button { kind: 1; glyph: "\u{e14d}"; text: @tr("Copy"); clicked => { Logic.copy-logs(); } }
            Button { kind: 3; glyph: "\u{e872}"; text: @tr("Clear"); clicked => { Logic.clear-logs(); } }
        }
        Rectangle {
            border-radius: 20px; background: Theme.surface-container-low; vertical-stretch: 1;
            if Ui.logs.length == 0: Text { text: @tr("Nothing here yet"); color: Theme.on-surface-variant; font-size: 13px; }
            ListView {
                for l in Ui.logs: HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 3px; padding-bottom: 3px; spacing: 10px;
                    Text { text: l.time; font-family: "Consolas"; font-size: 12px; color: Theme.on-surface-variant; width: 64px; }
                    Text { text: l.level; font-family: "Consolas"; font-size: 12px; width: 14px; color: l.level == "E" ? Theme.error : (l.level == "W" ? Theme.warn : Theme.primary); }
                    Text { text: l.text; font-family: "Consolas"; font-size: 12px; color: Theme.on-surface; wrap: char-wrap; horizontal-stretch: 1; }
                }
            }
        }
    }
}

// ============================================================ settings

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.primary; }
    Card { min-height: inner.preferred-height; inner := VerticalLayout { padding-top: 6px; padding-bottom: 6px; @children } }
}

component SmallField inherits Rectangle {
    in property <string> value;
    in property <length> w: 120px;
    callback commit(string);
    width: w; height: 36px; border-radius: 10px;
    background: Theme.surface-container-highest;
    border-width: inp.has-focus ? 2px : 0; border-color: Theme.primary;
    inp := TextInput {
        x: 12px; width: parent.width - 24px; vertical-alignment: center;
        text: root.value; font-size: 13px; color: Theme.on-surface; single-line: true;
        accepted => { root.commit(self.text); }
        changed has-focus => { if !self.has-focus && self.text != root.value { root.commit(self.text); } }
    }
}

export component SettingsPage inherits Rectangle {
    property <[color]> seeds: [#1f8bff, #6750a4, #b3261e, #e8590c, #f4b400, #2e7d32, #00897b, #0097a7, #c2185b, #5d4037];
    ScrollView {
        VerticalLayout {
            padding: 24px; spacing: 20px;
            Title { text: @tr("Settings"); }

            Section {
                title: @tr("Appearance");
                Row { title: @tr("Theme"); Segmented { width: 330px; options: [@tr("System"), @tr("Light"), @tr("Dark")]; index: Ui.settings.theme-mode; picked(i) => { Logic.set-int("theme-mode", i); } } }
                Row { title: @tr("Colours"); Segmented { width: 330px; options: [@tr("Windows accent"), @tr("Custom colour")]; index: Ui.settings.color-source; picked(i) => { Logic.set-int("color-source", i); } } }
                if Ui.settings.color-source == 1: Row {
                    title: @tr("Colour");
                    HorizontalLayout {
                        spacing: 8px;
                        for c in root.seeds: Rectangle {
                            width: 28px; height: 28px; border-radius: 14px; background: c;
                            border-width: Ui.settings.seed == c ? 3px : 0; border-color: Theme.on-surface;
                            TouchArea { mouse-cursor: pointer; clicked => { Logic.set-seed(c); } }
                        }
                    }
                }
                Row { title: @tr("Language"); Segmented { width: 330px; options: [@tr("System"), "English", "Русский"]; index: Ui.settings.language; picked(i) => { Logic.set-int("language", i); } } }
            }

            Section {
                title: @tr("Connection");
                Row { title: @tr("Mode"); subtitle: @tr("TUN captures all apps and needs administrator rights"); Segmented { width: 330px; options: [@tr("System proxy"), "TUN"]; index: Ui.settings.connect-mode; picked(i) => { Logic.set-connect-mode(i); } } }
                Row { title: @tr("SOCKS port"); SmallField { value: Ui.settings.socks-port; commit(t) => { Logic.set-text("socks-port", t); } } }
                Row { title: @tr("HTTP port"); SmallField { value: Ui.settings.http-port; commit(t) => { Logic.set-text("http-port", t); } } }
                Row { title: @tr("Allow LAN connections"); subtitle: @tr("Other devices in your network can use this proxy"); Switch { checked: Ui.settings.allow-lan; toggled(v) => { Logic.set-bool("allow-lan", v); } } }
                Row { title: @tr("Sniffing"); subtitle: @tr("Detect domains inside traffic for routing rules"); Switch { checked: Ui.settings.sniffing; toggled(v) => { Logic.set-bool("sniffing", v); } } }
                Row { title: "Mux"; subtitle: @tr("Several connections in one; may reduce speed"); Switch { checked: Ui.settings.mux; toggled(v) => { Logic.set-bool("mux", v); } } }
                Row { title: "IPv6"; Switch { checked: Ui.settings.ipv6; toggled(v) => { Logic.set-bool("ipv6", v); } } }
                Row { title: @tr("Strict DNS in TUN"); subtitle: @tr("Blocks DNS leaks past the tunnel"); Switch { checked: Ui.settings.tun-strict-dns; toggled(v) => { Logic.set-bool("tun-strict-dns", v); } } }
                Row { title: @tr("Remote DNS"); SmallField { w: 280px; value: Ui.settings.remote-dns; commit(t) => { Logic.set-text("remote-dns", t); } } }
                Row { title: @tr("Direct DNS"); SmallField { w: 280px; value: Ui.settings.direct-dns; commit(t) => { Logic.set-text("direct-dns", t); } } }
                Row { title: @tr("Ping URL"); SmallField { w: 280px; value: Ui.settings.ping-url; commit(t) => { Logic.set-text("ping-url", t); } } }
                Row { title: @tr("Log level"); Segmented { width: 400px; options: ["debug", "info", "warning", "error", "none"]; index: Ui.settings.log-level; picked(i) => { Logic.set-int("log-level", i); } } }
            }

            Section {
                title: @tr("Subscriptions");
                Row { title: @tr("Present as"); subtitle: @tr("Some services only give servers to certain clients"); Segmented { width: 330px; options: [@tr("None"), "Happ", "INCY"]; index: Ui.settings.client-spoof; picked(i) => { Logic.set-int("client-spoof", i); } } }
                Row { title: "User-Agent"; SmallField { w: 220px; value: Ui.settings.user-agent; commit(t) => { Logic.set-text("user-agent", t); } } }
                Row { title: @tr("Routing from the service"); subtitle: @tr("Apply routing profiles and rules that come with subscriptions"); Switch { checked: Ui.settings.apply-panel-routing; toggled(v) => { Logic.set-bool("apply-panel-routing", v); } } }
                Row { title: @tr("Hide server addresses"); subtitle: @tr("Handy for screenshots and streams"); Switch { checked: Ui.settings.mask-addresses; toggled(v) => { Logic.set-bool("mask-addresses", v); } } }
                Row { title: "HWID"; subtitle: Ui.settings.hwid; IconButton { glyph: "\u{e14d}"; clicked => { Logic.copy(Ui.settings.hwid); } } }
            }

            Section {
                title: @tr("Core");
                Row { title: "Xray-core"; subtitle: Ui.core-version; Button { kind: 1; glyph: "\u{e2c4}"; text: @tr("Update"); clicked => { Logic.update-core(); } } }
                Row { title: @tr("Geo source"); subtitle: @tr("runetfreedom has up-to-date lists of sites blocked in Russia"); Segmented { width: 330px; options: ["v2fly", @tr("runetfreedom (RU)")]; index: Ui.settings.geo-source; picked(i) => { Logic.set-int("geo-source", i); } } }
                Row { title: @tr("Geo databases"); Button { kind: 1; glyph: "\u{e5d5}"; text: @tr("Update"); clicked => { Logic.update-geo(); } } }
            }

            Section {
                title: @tr("Notifications");
                Row { title: @tr("Connect and disconnect"); Switch { checked: Ui.settings.notify-connection; toggled(v) => { Logic.set-bool("notify-connection", v); } } }
                Row { title: @tr("Errors"); Switch { checked: Ui.settings.notify-errors; toggled(v) => { Logic.set-bool("notify-errors", v); } } }
                Row { title: @tr("Subscription ending"); Switch { checked: Ui.settings.notify-subscription; toggled(v) => { Logic.set-bool("notify-subscription", v); } } }
                Row { title: @tr("New versions"); Switch { checked: Ui.settings.notify-updates; toggled(v) => { Logic.set-bool("notify-updates", v); } } }
            }

            Section {
                title: @tr("System");
                Row { title: @tr("Start with Windows"); Switch { checked: Ui.settings.autostart; toggled(v) => { Logic.set-bool("autostart", v); } } }
                Row { title: @tr("Connect on start"); Switch { checked: Ui.settings.auto-connect; toggled(v) => { Logic.set-bool("auto-connect", v); } } }
                Row { title: @tr("Close to tray"); subtitle: @tr("The close button keeps Uplinx running in the tray"); Switch { checked: Ui.settings.minimize-to-tray; toggled(v) => { Logic.set-bool("minimize-to-tray", v); } } }
                Row { title: @tr("Check for updates"); subtitle: "Uplinx " + Ui.app-version; HorizontalLayout { spacing: 12px;
                    Switch { y: 4px; checked: Ui.settings.check-updates; toggled(v) => { Logic.set-bool("check-updates", v); } }
                    Button { kind: 1; text: @tr("Check now"); clicked => { Logic.check-updates(); } } } }
                Row { title: @tr("Data folder"); Button { kind: 2; glyph: "\u{e2c7}"; text: @tr("Open"); clicked => { Logic.open-data-folder(); } } }
            }

            Section {
                title: @tr("About");
                Row { title: "Uplinx " + Ui.app-version; subtitle: @tr("Proxy client with Xray-core. Flags — Twemoji (CC-BY 4.0)."); IconButton { glyph: "\u{e86f}"; clicked => { Logic.open-url("https://github.com/alexkonstich-byte/uplinx"); } } }
            }
        }
    }
}
