// Uplinx — Rust/Slint UI. Material You 3 Expressive look, colours fed from Rust (dynamic scheme).
import "fonts/Rubik.ttf";
import "fonts/Unbounded.ttf";
import "fonts/MaterialIconsRound-Regular.otf";
import { Shapes } from "shapes.slint";

export global Theme {
    in property <color> primary: #8d4e2a;
    in property <color> on-primary: #ffffff;
    in property <color> primary-container: #ffdbca;
    in property <color> on-primary-container: #331100;
    in property <color> secondary-container: #ffdbca;
    in property <color> on-secondary-container: #2c160b;
    in property <color> tertiary: #646032;
    in property <color> surface: #1a120e;
    in property <color> surface-container: #271e1a;
    in property <color> surface-container-high: #322824;
    in property <color> surface-container-highest: #3d332e;
    in property <color> on-surface: #f0dfd8;
    in property <color> on-surface-variant: #d7c2b9;
    in property <color> outline-variant: #52443c;
    in property <color> error: #ffb4ab;
    in property <bool> motion: true;   // false while the window is in the background
}

export global Logic {
    callback toggle-connect();
    callback minimize();
    callback toggle-maximize();
    callback close();
    callback drag();
}

component Icon inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: "Material Icons Round";
    font-size: 22px;
    color: Theme.on-surface;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    background: ta.has-hover ? (danger ? #c42b1c : Theme.on-surface.with-alpha(0.08)) : transparent;
    animate background { duration: 120ms; }
    Icon { glyph: root.glyph; font-size: 16px; color: ta.has-hover && danger ? white : Theme.on-surface; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TitleBar inherits Rectangle {
    in property <bool> connected;
    in property <string> server;
    in property <bool> maximized;
    height: 40px;
    background: Theme.surface-container;
    drag := TouchArea {
        pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) { Logic.drag(); } }
        double-clicked => { Logic.toggle-maximize(); }
    }
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        alignment: start;
        Text { text: "Uplinx"; font-family: "Unbounded"; font-weight: 600; font-size: 13px; color: Theme.on-surface; vertical-alignment: center; }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 24px;
            width: status-text.preferred-width + 34px;
            border-radius: 12px;
            background: Theme.surface-container-highest;
            Rectangle { x: 10px; width: 8px; height: 8px; border-radius: 4px; background: root.connected ? #2ec27e : Theme.on-surface-variant; }
            status-text := Text {
                x: 26px;
                text: root.connected ? "Connected · " + root.server : "Not connected";
                font-size: 12px; color: Theme.on-surface; vertical-alignment: center;
            }
        }
    }
    HorizontalLayout {
        alignment: end;
        WindowButton { glyph: "\u{e15b}"; clicked => { Logic.minimize(); } }
        WindowButton { glyph: root.maximized ? "\u{e3e0}" : "\u{e3c6}"; clicked => { Logic.toggle-maximize(); } }
        WindowButton { glyph: "\u{e5cd}"; danger: true; clicked => { Logic.close(); } }
    }
}

component RailItem inherits VerticalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    spacing: 4px;
    alignment: center;
    Rectangle {
        height: 32px;
        width: 56px;
        x: (parent.width - self.width) / 2;
        border-radius: 16px;
        background: root.selected ? Theme.secondary-container : (ta.has-hover ? Theme.on-surface.with-alpha(0.08) : transparent);
        animate background { duration: 200ms; easing: ease-out; }
        Icon { glyph: root.glyph; color: root.selected ? Theme.on-secondary-container : Theme.on-surface-variant; }
        ta := TouchArea { clicked => { root.clicked(); } }
    }
    Text { text: root.label; font-size: 12px; font-weight: root.selected ? 700 : 500; color: Theme.on-surface-variant; horizontal-alignment: center; }
}

/** The hero button: a 9-sided cookie that keeps turning, faster when connected. */
component ConnectButton inherits Rectangle {
    in property <int> state; // 0 off, 1 busy, 2 on
    in property <length> size: 220px;
    width: size * 1.45; height: size * 1.45;
    property <float> speed: state == 1 ? 1.0 / 1.4 : (state == 2 ? 1.0 / 14 : 1.0 / 32);
    property <angle> spin: Theme.motion ? mod(animation-tick() / 1s * speed, 1.0) * 360deg : 0deg;
    // breathing halo while connected
    halo := Rectangle {
        width: root.size * 1.3; height: self.width;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.primary.with-alpha(root.state == 2 ? 0.12 : 0);
        animate background { duration: 600ms; }
    }
    shape := Rectangle {
        width: root.size; height: root.size;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        transform-rotation: root.spin;
        transform-scale: ta.pressed ? 0.92 : (ta.has-hover ? 1.04 : 1.0);
        animate transform-scale { duration: 220ms; easing: ease-out-back; }
        Path {
            width: 100%; height: 100%;
            viewbox-width: 100; viewbox-height: 100;
            commands: root.state == 0 ? Shapes.cookie12 : Shapes.cookie9;
            fill: root.state == 2 ? Theme.primary : (root.state == 1 ? Theme.secondary-container : Theme.surface-container-highest);
            animate fill { duration: 400ms; }
        }
    }
    Icon {
        glyph: "\u{e8ac}";
        font-size: root.size * 0.32;
        color: root.state == 2 ? Theme.on-primary : (root.state == 1 ? Theme.on-secondary-container : Theme.on-surface-variant);
        animate color { duration: 400ms; }
    }
    ta := TouchArea { clicked => { Logic.toggle-connect(); } }
}

export component AppWindow inherits Window {
    title: "Uplinx";
    icon: @image-url("../../packaging/uplinx-512.png");
    no-frame: true;
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 620px;
    background: Theme.surface;
    default-font-family: "Rubik";

    in property <int> status;        // 0 off, 1 busy, 2 on
    in property <string> server-name;
    in property <string> server-detail;
    in property <bool> is-maximized;
    in-out property <int> page: 0;

    VerticalLayout {
        TitleBar { connected: root.status == 2; server: root.server-name; maximized: root.is-maximized; }
        HorizontalLayout {
            // navigation rail
            Rectangle {
                width: 96px;
                background: Theme.surface-container;
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 14px;
                    alignment: start;
                    Rectangle { height: 56px; }
                    RailItem { glyph: "\u{e88a}"; label: "Home"; selected: root.page == 0; clicked => { root.page = 0; } }
                    RailItem { glyph: "\u{e875}"; label: "Servers"; selected: root.page == 1; clicked => { root.page = 1; } }
                    RailItem { glyph: "\u{eb5a}"; label: "Subs"; selected: root.page == 2; clicked => { root.page = 2; } }
                    RailItem { glyph: "\u{f184}"; label: "Routing"; selected: root.page == 3; clicked => { root.page = 3; } }
                    RailItem { glyph: "\u{eb8e}"; label: "Logs"; selected: root.page == 4; clicked => { root.page = 4; } }
                    Rectangle { vertical-stretch: 1; }
                    RailItem { glyph: "\u{e8b8}"; label: "Settings"; selected: root.page == 5; clicked => { root.page = 5; } }
                }
            }
            // content
            Rectangle {
                if root.page == 0: VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout { alignment: center; ConnectButton { state: root.status; } }
                    Text {
                        text: root.status == 2 ? "Connected" : (root.status == 1 ? "Connecting…" : "Not connected");
                        font-family: "Unbounded"; font-weight: 600; font-size: 34px; color: Theme.on-surface; horizontal-alignment: center;
                    }
                    Text { text: root.server-name; font-size: 16px; color: Theme.on-surface-variant; horizontal-alignment: center; }
                    Text { text: root.server-detail; font-size: 12px; color: Theme.on-surface-variant; horizontal-alignment: center; }
                }
                if root.page != 0: Text {
                    text: "This screen is being ported from the Kotlin version.";
                    color: Theme.on-surface-variant; font-size: 16px;
                }
            }
        }
    }
}
